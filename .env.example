# Copier ce fichier en .env et mettre les valeurs données par les animateurs
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
# la base est partagée et les tables existent déjà, ne pas mettre true
DB_SYNCHRONIZE=false

# secret qui signe les jetons de connexion (au moins 32 caractères)
JWT_SECRET=
